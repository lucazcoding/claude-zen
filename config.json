{
  "listen": {
    "host": "127.0.0.1",
    "port": 8787
  },

  "routing": {
    "mode": "auto",
    "largeContextThreshold": 100000,

    "normalProvider": "apinex",
    "largeContextProvider": "gemini",

    "fallbackOrder": [
      "apinex",
      "gemini",
      "openrouter-qwen",
      "openrouter-laguna"
    ],

    "cooldownSeconds": 300
  },

  "providers": {
    "apinex": {
      "name": "APInex",
      "baseUrl": "https://api.apinex.bond/v1",
      "model": "free/mimo-v2.6-pro",
      "apiKeyEnv": "APINEX_API_KEY",
      "timeoutMs": 600000
    },

    "gemini": {
      "name": "Google Gemini",
      "baseUrl": "https://generativelanguage.googleapis.com/v1beta/openai",
      "model": "gemini-3.8-flash",
      "apiKeyEnv": "GEMINI_API_KEY",
      "timeoutMs": 600000
    },

    "openrouter-qwen": {
      "name": "OpenRouter Qwen",
      "baseUrl": "https://openrouter.ai/api/v1",
      "model": "qwen/qwen3.8-27b:free",
      "apiKeyEnv": "CLAUDEZEN_OPENROUTER_QWEN_API_KEY",
      "timeoutMs": 600000
    },

    "openrouter-laguna": {
      "name": "OpenRouter Laguna",
      "baseUrl": "https://openrouter.ai/api/v1",
      "model": "poolside/laguna-s-2.1:free",
      "apiKeyEnv": "CLAUDEZEN_OPENROUTER_LAGUNA_API_KEY",
      "timeoutMs": 600000
    }
  },

  "reasoningContent": "auto",

  "reasoningCacheMaxEntries": 0,

  "reasoningCacheMaxAgeMs": 2592000000,

  "reasoningCacheMaxSizeBytes": 209715200,

  "reasoningCachePath": "~/.claudezen/reasoning-cache.json",

  "requestBodyLimitBytes": 104857600,

  "upstreamTimeoutMs": 600000
}